APP_NAME="Portal Resmi Instansi Pemerintah - Paket Gold"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8001

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Client Tier Package: silver | gold | platinum
SITE_PACKAGE=gold

# Initial Super Admin credentials (min 12 characters password)
SUPER_ADMIN_NAME="Super Admin HJT Gold"
SUPER_ADMIN_EMAIL="admin@hayatjaya.com"
SUPER_ADMIN_PASSWORD="HayatJaya#2026!Secure"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database configuration
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/database_gold.sqlite
# DB_DATABASE=portal_instansi_gold
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hayatjaya.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SESSION_COOKIE=hjt_gold_session
CACHE_PREFIX=hjt_gold_cache
REDIS_PREFIX=hjt_gold_database_
